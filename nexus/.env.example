# Nexus — Memoa Cloud Sync Hub & AI Gateway
#
# Copy this file to .env and adjust values for your environment.

# Server
NEXUS_HOST=127.0.0.1
NEXUS_PORT=3721
NEXUS_UPLOAD_LIMIT_MB=50

# Database
NEXUS_DB_PATH=data/nexus.db

# Auth (change JWT secret in production!)
NEXUS_JWT_SECRET=nexus-dev-secret-change-in-production
NEXUS_TOKEN_EXPIRY_HOURS=720

# Storage (local or s3)
NEXUS_STORAGE_TYPE=local
NEXUS_STORAGE_DATA_DIR=data/files
# For S3-compatible storage:
# NEXUS_STORAGE_TYPE=s3
# NEXUS_S3_ENDPOINT=https://s3.amazonaws.com
# NEXUS_S3_BUCKET=memoa-vaults
# NEXUS_S3_REGION=us-east-1
# NEXUS_S3_ACCESS_KEY=your-access-key
# NEXUS_S3_SECRET_KEY=your-secret-key

# AI Gateway
NEXUS_GATEWAY_ENABLED=true
NEXUS_GATEWAY_RATE_LIMIT=30
NEXUS_GATEWAY_TIMEOUT_SECS=120

# Upstream AI models (JSON array)
# NEXUS_UPSTREAM_MODELS=[{"name":"openai-gpt-4o","base_url":"https://api.openai.com","api_key_env":"OPENAI_API_KEY","provider":"openai"},{"name":"deepseek-chat","base_url":"https://api.deepseek.com","api_key_env":"DEEPSEEK_API_KEY","provider":"deepseek"},{"name":"zhipu-glm-4","base_url":"https://open.bigmodel.cn/api/paas/v4","api_key_env":"ZHIPU_API_KEY","provider":"zhipu"}]

# API keys for upstream providers
# OPENAI_API_KEY=sk-...
# DEEPSEEK_API_KEY=sk-...
# ZHIPU_API_KEY=...